# لا تضع القيم الحقيقية في هذا الملف — هذا مجرد مثال توضيحي.
# أضف هذه المتغيرات فعليًا من لوحة Vercel:
# Project → Settings → Environment Variables

# توكن GitHub (Fine-grained Personal Access Token) بصلاحية القراءة/الكتابة
# على مستودع البيانات الخاص فقط (Contents: Read and write)
GITHUB_TOKEN=

# اسم المستخدم أو المنظمة المالكة لمستودع البيانات
GITHUB_OWNER=

# اسم مستودع البيانات الخاص (Private) الذي يحتوي على students.json
GITHUB_DATA_REPO=

# اسم الفرع (عادة main)
GITHUB_BRANCH=main

# مسار الملف داخل مستودع البيانات
GITHUB_FILE_PATH=students.json

# كلمة مرور المعلم للدخول إلى admin.html (يتم التحقق منها في الخادم فقط)
ADMIN_PASSWORD=
